<?xml version="1.0"?>
<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro" name="module_quadrotor">

  <!-- general attribute -->
  <baselink name="fc" />
  <thrust_link name="thrust" />

  <!-- kinematics [m] -->
  <xacro:property name="rotor_x" value="0.160" />
  <xacro:property name="rotor_y" value="0.160" />
  <xacro:property name="rotor_z" value="0.030" />

  <!-- dynamics -->
  <m_f_rate value="-0.011" /> <!-- drag torque rate -->
  <xacro:property name="max_force" value="8.0" /> <!-- [N] -->
  <xacro:property name="min_force" value="0.0" /> <!-- [N] -->

  <!-- friction -->
  <xacro:macro name="damping_factor" params="link">
    <gazebo reference="main_body">
      <dampingFactor>0.00</dampingFactor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="extra_module"
    params="name parent *origin *inertial visible:=0 model_url:=1 scale:=1">
    <joint name="${parent}2${name}" type="fixed">
      <parent link="${parent}" />
      <child link="${name}" />
      <xacro:insert_block name="origin" />
    </joint>
    <link name="${name}">
      <xacro:insert_block name="inertial" />
      <xacro:if value="${visible == 1}">
        <visual>
          <origin rpy="0 0 0" xyz="0 0 0" />
          <geometry>
            <mesh filename="${model_url}" scale="${scale} ${scale} ${scale}" />
          </geometry>
        </visual>
      </xacro:if>
    </link>
  </xacro:macro>


  <!-- dummy root link for KDL -->
  <link name="root">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.00001" />
      <inertia
        ixx="0.000001" ixy="0.0" ixz="0.0"
        iyy="0.000001" iyz="0.0"
        izz="0.000002" />
    </inertial>
  </link>
  <joint name="root_joint" type="fixed">
    <parent link="root" />
    <child link="main_body" />
    <origin rpy="0 0 0" xyz="0 0 0" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- main_body -->
  <link name="main_body">
    <inertial>
      <mass value="0.210" />
      <origin xyz="0 0 0.018" rpy="0 0 0" />
      <inertia
        ixx="0.000096398" ixy="0" ixz="0"
        iyy="0.000098683" iyz="0"
        izz="0.000157235" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/kinikun_main_body.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.1 0.1 0.01" />
      </geometry>
    </collision>
  </link>

  <!-- spinal -->
  <xacro:extra_module name="fc" parent="main_body" visible="0">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <inertial>
      <mass value="00" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia
        ixx="0.0" ixy="0.0" ixz="0.0"
        iyy="0.0" iyz="0.0" izz="0.0" />
    </inertial>
  </xacro:extra_module>

  <!-- battery
  <xacro:extra_module name="battery" parent="main_body" visible="1"
    model_url="package://kinikun/urdf/mesh/turnigy_3S_2200mAh.dae">
    <origin xyz="0.0105 0 -0.012" rpy="0 0 0" />
    <inertial>
      <mass value="0.188" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia
        ixx="0.0002" ixy="0.0" ixz="0.0"
        iyy="0.0002" iyz="0.0" izz="0.0002" />
    </inertial>
  </xacro:extra_module> -->

  <joint name="arm1_joint" type="fixed">
    <!-- <limit lower="${-pi/4}" upper="${pi/4}" effort="10.0" velocity="0.5"/> -->
    <parent link="main_body" />
    <child link="arm1_link" />
    <origin xyz="-0.03023 -0.03023 0.004" rpy="0 0 ${ -3*pi / 4}" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.9" friction="0.05" />
  </joint>

  <link name="arm1_link">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <inertial>
      <origin xyz="0.148 -0.004 0" rpy="0 0 0" />
      <mass value="0.120" />
      <inertia
        ixx="0.000100424" iyy="0.000408408" izz="0.000429299"
        ixy="0" ixz="0.00004" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/kinikun_foot_R.dae" />
      </geometry>
    </visual>
  </link>

  <joint name="rotor1" type="continuous">
    <parent link="arm1_link" />
    <child link="thrust1" />
    <origin xyz="0.179 0 0.0209" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit effort="100" lower="${min_force}" upper="${max_force}" velocity="0.5" />
  </joint>

  <link name="thrust1">
    <!-- visual & collisiont -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0091" />
      <inertia
        ixx="0.00000807" ixy="0.0" ixz="0.0"
        iyy="0.00000807" iyz="0.0"
        izz="0.00001612" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/prop_5inch.dae" />
      </geometry>
    </visual>
  </link>

  <xacro:damping_factor link="thrust1" />
  <transmission name="rotor_tran1">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor1">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor1">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <joint name="arm2_joint" type="revolute">
    <limit lower="${-pi/4}" upper="${pi/4}" effort="1.0" velocity="0.5" />
    <parent link="main_body" />
    <child link="arm2_link" />
    <origin xyz="0.03023 -0.03023 0.004" rpy="0 0 ${- pi / 4}" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.9" friction="0.05" />
  </joint>

  <link name="arm2_link">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <inertial>
      <origin xyz="0.148 -0.004 0" rpy="0 0 0" />
      <mass value="0.2" />
      <!-- <mass value="0.157" /> -->
      <inertia
        ixx="0.000100425" iyy="0.000408408" izz="0.000429300"
        ixy="0" ixz="0.00004" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/kinikun_foot_L.dae" />
      </geometry>
    </visual>
  </link>

  <joint name="rotor2" type="continuous">
    <parent link="arm2_link" />
    <child link="thrust2" />
    <origin xyz="0.179 0 0.0209" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="100" lower="${min_force}" upper="${max_force}" velocity="0.5" />
  </joint>

  <link name="thrust2">
    <!-- visual & collisiont -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0091" />
      <inertia
        ixx="0.00000807" ixy="0.0" ixz="0.0"
        iyy="0.00000807" iyz="0.0"
        izz="0.00001612" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/prop_5inch.dae" />
      </geometry>
    </visual>
  </link>

  <xacro:damping_factor link="thrust2" />
  <transmission name="rotor_tran2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor2">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor2">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  
  <transmission name="joint_tran2">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="arm2_joint">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="servo2">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <joint name="arm3_joint" type="revolute">
    <limit lower="${-pi/3}" upper="${pi/3}" effort="1.0" velocity="0.5" />
    <parent link="main_body" />
    <child link="arm3_link" />
    <origin xyz="0.03023 0.03023 0.004" rpy="0 0 ${ pi / 4}" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.9" friction="0.05" />
  </joint>

  <link name="arm3_link">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <inertial>
      <origin xyz="0.148 -0.004 0" rpy="0 0 0" />
      <mass value="0.2" />
      <inertia
        ixx="0.000100424" iyy="0.000408408" izz="0.000429299"
        ixy="0" ixz="0.00004" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/kinikun_foot_R.dae" />
      </geometry>
    </visual>
  </link>

  <joint name="rotor3" type="continuous">
    <parent link="arm3_link" />
    <child link="thrust3" />
    <origin xyz="0.179 0 0.0209" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit effort="100" lower="${min_force}" upper="${max_force}" velocity="0.5" />
  </joint>

  <link name="thrust3">
    <!-- visual & collisiont -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0091" />
      <inertia
        ixx="0.00000807" ixy="0.0" ixz="0.0"
        iyy="0.00000807" iyz="0.0"
        izz="0.00001612" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/prop_5inch.dae" />
      </geometry>
    </visual>
  </link>

  <xacro:damping_factor link="thrust3" />
  <transmission name="rotor_tran3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor3">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor3">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <transmission name="joint_tran3">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="arm3_joint">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="servo3">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <joint name="arm4_joint" type="fixed">
    <!-- <limit lower="${-pi/4}" upper="${pi/4}" effort="10.0" velocity="0.5"/> -->
    <parent link="main_body" />
    <child link="arm4_link" />
    <origin xyz="-0.03023 0.03023 0.004" rpy="0 0 ${3* pi / 4}" />
    <axis xyz="0 0 1" />
    <dynamics damping="0.9" friction="0.05" />
  </joint>
  
  <link name="arm4_link">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <inertial>
      <origin xyz="0.148 -0.004 0" rpy="0 0 0" />
      <mass value="0.12" />
      <inertia
        ixx="0.000100425" iyy="0.000408408" izz="0.000429300"
        ixy="0" ixz="0.00004" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/kinikun_foot_L.dae" />
      </geometry>
    </visual>
  </link>

  <joint name="rotor4" type="continuous">
    <parent link="arm4_link" />
    <child link="thrust4" />
    <origin xyz="0.179 0 0.0209" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="100" lower="${min_force}" upper="${max_force}" velocity="0.5" />
  </joint>
  
  <link name="thrust4">
    <!-- visual & collisiont -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0091" />
      <inertia
        ixx="0.00000807" ixy="0.0" ixz="0.0"
        iyy="0.00000807" iyz="0.0"
        izz="0.00001612" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://kinikun/urdf/mesh/prop_5inch.dae" />
      </geometry>
    </visual>
  </link>
  
  <xacro:damping_factor link="thrust4" />
  <transmission name="rotor_tran4">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor4">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor4">
      <!-- TODO: effort is torque, maybe position is enough -->
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <joint name="arm2_dummy_joint_1" type="revolute">
    <parent link="arm2_link" />
    <child link="dummy_gripper_1" />
    <origin xyz="0.2 0.02 0" rpy="0 0 0" /> <!-- 位置を調整 -->
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.01" effort="0" velocity="0" />
    <dynamics damping="0.2" friction="0.02" />
  </joint>
  
  <link name="dummy_gripper_1">
    <inertial>
        <mass value="0.00001" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia 
          ixx="0.000001" ixy="0.0" ixz="0.0" 
          iyy="0.000001" iyz="0.0" izz="0.000002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0.0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <joint name="arm2_dummy_joint_2" type="revolute">
    <parent link="arm2_link" />
    <child link="dummy_gripper_2" />
    <origin xyz="0.2 -0.02 0" rpy="0 0 0" /> <!-- 位置を調整 -->
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.01" effort="0" velocity="0" />
    <dynamics damping="0.2" friction="0.02" />
  </joint>

  <link name="dummy_gripper_2">
    <inertial>
        <mass value="0.00001" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0.0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

<!-- arm3_linkの先端にダミーリンクを追加 -->
  <joint name="arm3_dummy_joint_1" type="revolute">
    <parent link="arm3_link" />
    <child link="dummy_gripper_3" />
    <origin xyz="0.2 0.02 0" rpy="0 0 0" /> <!-- 位置を調整 -->
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.01" effort="0" velocity="0" />
    <dynamics damping="0.2" friction="0.02" />
  </joint>
  
  <link name="dummy_gripper_3">
    <inertial>
        <mass value="0.00001" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0.0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <joint name="arm3_dummy_joint_2" type="revolute">
    <parent link="arm3_link" />
    <child link="dummy_gripper_4" />
    <origin xyz="0.2 -0.02 0" rpy="0 0 0" /> <!-- 位置を調整 -->
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.01" effort="0" velocity="0" />
    <dynamics damping="0.2" friction="0.02" />
  </joint>

  <link name="dummy_gripper_4">
    <inertial>
        <mass value="0.00001" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0.0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

</robot>