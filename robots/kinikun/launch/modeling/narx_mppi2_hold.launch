<?xml version="1.0"?>
<launch>
  <!-- NARX-MPPI Controller with Hold Mode -->
  
  <!-- Model Configuration -->
  <arg name="model_dir" default="$(find kinikun)/models/out_narx2"/>
  
  <!-- Control Rate -->
  <arg name="rate" default="100"/>
  <arg name="frame_skip" default="2"/>
  
  <!-- MPPI Parameters -->
  <arg name="K" default="32"/>
  <arg name="horizon" default="15"/>
  <arg name="lambda" default="2.0"/>
  <arg name="sigma_u" default="0.10"/>
  
  <!-- Hold Mode Parameters -->
  <arg name="hold_threshold_deg" default="2.0"/>      <!-- 目標到達判定: ±2° -->
  <arg name="hold_duration_s" default="1.0"/>         <!-- 1秒継続で確定 -->
  <arg name="sigma_u_decay" default="0.95"/>          <!-- 感度減衰率 -->
  <arg name="sigma_u_min" default="0.02"/>            <!-- 最小感度 -->
  
  <!-- Cost Weights -->
  <arg name="w_tracking" default="30.0"/>
  <arg name="w_smooth" default="0.05"/>
  <arg name="w_effort" default="0.01"/>
  <arg name="w_constraint" default="500.0"/>
  
  <!-- Physical Limits -->
  <arg name="p_max" default="0.70"/>
  <arg name="dp_max" default="3.5"/>
  <arg name="pressure_delay_s" default="0.084"/>
  
  <!-- Topics -->
  <arg name="theta_topic" default="/kinikun1/joint_states"/>
  <arg name="theta_index" default="2"/>
  <arg name="target_topic" default="/theta_target_deg"/>
  <arg name="pressure_topic" default="/mpa_pressure"/>
  <arg name="cmd_topic" default="/mpa_cmd"/>
  
  <!-- Logging -->
  <arg name="log_csv" default="/home/keiichiro/ros/jsk_aerial_robot_ws/src/jsk_aerial_robot/robots/kinikun/scripts/pressure_control/mppi/logs/mppi_hold_log.csv"/>
  
  <!-- Node -->
  <node name="narx_mppi_controller_hold" pkg="kinikun" 
        type="narx_mppi_controller_with_hold.py"
        output="screen" respawn="false">
    
    <!-- Model -->
    <param name="model_dir" value="$(arg model_dir)"/>
    
    <!-- Control -->
    <param name="rate" value="$(arg rate)"/>
    <param name="frame_skip" value="$(arg frame_skip)"/>
    
    <!-- MPPI -->
    <param name="K" value="$(arg K)"/>
    <param name="horizon" value="$(arg horizon)"/>
    <param name="lambda" value="$(arg lambda)"/>
    <param name="sigma_u" value="$(arg sigma_u)"/>
    
    <!-- Hold Mode -->
    <param name="hold_threshold_deg" value="$(arg hold_threshold_deg)"/>
    <param name="hold_duration_s" value="$(arg hold_duration_s)"/>
    <param name="sigma_u_decay" value="$(arg sigma_u_decay)"/>
    <param name="sigma_u_min" value="$(arg sigma_u_min)"/>
    
    <!-- Costs -->
    <param name="w_tracking" value="$(arg w_tracking)"/>
    <param name="w_smooth" value="$(arg w_smooth)"/>
    <param name="w_effort" value="$(arg w_effort)"/>
    <param name="w_constraint" value="$(arg w_constraint)"/>
    
    <!-- Limits -->
    <param name="p_max" value="$(arg p_max)"/>
    <param name="dp_max" value="$(arg dp_max)"/>
    <param name="pressure_delay_s" value="$(arg pressure_delay_s)"/>
    
    <!-- Topics -->
    <param name="theta_topic" value="$(arg theta_topic)"/>
    <param name="theta_index" value="$(arg theta_index)"/>
    <param name="target_topic" value="$(arg target_topic)"/>
    <param name="pressure_topic" value="$(arg pressure_topic)"/>
    <param name="cmd_topic" value="$(arg cmd_topic)"/>
    
    <!-- Logging -->
    <param name="log_csv" value="$(arg log_csv)"/>
  </node>
  
</launch>